[Unit]
Description=Export ghvshort active links to JSON
After=network.target

[Service]
Type=oneshot
User=ghvshort
Group=ghvshort
Environment=GHVSHORT_CONFIG=/etc/ghvshort/config.toml
UMask=0022
ExecStart=/usr/bin/ghvshort export-json

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ghvshort
